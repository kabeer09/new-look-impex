# New Look Impex — AI SEO & Enquiry Growth Engine
DATABASE_URL=sqlite:///./newlookimpex.db
# For production: postgresql+psycopg2://user:pass@host:5432/newlookimpex
SECRET_KEY=change-me-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@newlookimpex.example
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_DOMAIN=newlookimpex.example

# LLM provider abstraction (optional — app works rule-based without it)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GA4_PROPERTY_ID=

# Google Sign-In for the admin dashboard (optional, disabled by default)
GOOGLE_LOGIN_ENABLED=false
# Who may sign in with Google (comma-separated). Empty = only ADMIN_EMAIL.
# First-time Google users get role "editor" (ADMIN_EMAIL gets "admin").
GOOGLE_ALLOWED_EMAILS=
# Must be registered in Google Cloud console as an authorised redirect URI.
# Empty = API_BASE_URL + /api/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=

# n8n webhooks
N8N_WEBHOOK_TOKEN=change-me-n8n-token
ENQUIRY_NOTIFY_EMAIL=newlookimpex@gmail.com

# SMTP (optional — app works without it; email_sent=false in responses)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=

# Media storage: local (dev) or s3 (any S3-compatible object storage,
# e.g. AWS S3 or Supabase Storage via its S3 endpoint). See docs/image-storage.md
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# Drop-folder auto-import (VS Code workflow): drop product photos into
# incoming/products/<optional-category-slug>/ and banner images into
# incoming/banners/ — ingested automatically. See incoming/products/README.md.
# Products are always created as drafts unless INCOMING_AUTO_PUBLISH=true.
INCOMING_ENABLED=false
INCOMING_DIR=./incoming
INCOMING_INTERVAL=60
INCOMING_AUTO_PUBLISH=false
INCOMING_RIGHTS=own
