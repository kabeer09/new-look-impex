            </div>
            <button
              type="submit"
              className="btn bg-gold text-navy hover:bg-brass-dark !px-8 !py-3"
            >
              Request Wholesale Enquiry
            </button>
          </form>
          <p className="mt-8 text-charcoal/60 text-sm">
            New Look Impex • Moradabad, Uttar Pradesh 244001, India • GSTIN 09AFKPA4462R1ZW
          </p>
        </div>
