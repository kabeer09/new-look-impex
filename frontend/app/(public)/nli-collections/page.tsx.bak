import { PageHero } from "@/components/public/Shared";

export default function NliCollectionsBrandPage() {
  const [products, setProducts] = useState<ProductCard[] | null>(null);
  const [err, setErr] = useState("");

  useEffect(() => {
    setErr("");
    api<{ items: ProductCard[]; total?: number }>(
      "/api/public/products?page_size=40"
    )
      .then((d) => setProducts(d.items || []))
      .catch((e) => setErr(String(e)));
  }, []);

  // Product sections - filter by material from product data
  const brassProducts = products?.filter((p) =>
    /brass|Brass/.test(p.material || "") || /brass|Brass/.test(p.category?.name || "")
  ) || [];
