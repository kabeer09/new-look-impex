# Use 127.0.0.1, NOT localhost: on Windows, browsers resolve localhost to ::1
# first, where unrelated software (WSL relay, Docker) may already occupy
# port 8000 and break API calls with "Failed to fetch".
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CLOUDINARY_CLOUD=fxvyj0ae

# NextAuth.js Authentication
NEXTAUTH_URL=https://www.newlookimpex.store
NEXTAUTH_SECRET=your-nextauth-secret-must-be-at-least-32-characters-long
GOOGLE_CLIENT_ID=578751174344-arjh5nn5beq0gfmm0gkphpifbmo4bkve.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
